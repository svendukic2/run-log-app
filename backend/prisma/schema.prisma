// Run Log Tracker - database shape, live since RUN-46 (see docs/data-model.md,
// "Adopting the database"). Mirrors the TypeScript types in frontend/src/lib/
// and must stay in sync with them: string ids, calendar-day dates, durations
// in seconds, capitalized enums as plain strings, derived data (records,
// totals, pace) never stored.

// Prisma 7: the client is generated TypeScript compiled with the rest of the
// app, and the connection URL lives in prisma.config.ts (CLI) and
// PrismaService (runtime), not here.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The backend emits CommonJS: tsconfig is "module": "nodenext" and
  // package.json has no "type": "module", which under nodenext means CJS
  // output. The default ESM generator output (import.meta) does not survive
  // that, hence cjs here.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Single row: Run Log has no accounts (WEL-4). runningLevel is one of
// Beginner | Intermediate | Advanced (LVL-2); defaultWeeklyGoalKm seeds
// future weeks only (SET-3, SET-6).
model Profile {
  id                  String @id @default(cuid())
  firstName           String
  lastName            String
  email               String
  runningLevel        String
  defaultWeeklyGoalKm Int
}

// Single row: the onboarding goal period (GOAL-2..4). km stays within 0-60
// (A17); endDate null renders as "No end date".
model Goal {
  id        String    @id @default(cuid())
  km        Int
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
}

// At most one row per week, keyed by the Monday of that week. Snapshotted from
// the goal's km the first time a week is used, then only changed by the
// coach's "Apply to weekly goal" for the current week (AIC-5, A15). Past rows
// never change, which is what makes Hit/Missed history possible (AIC-7).
model WeekTarget {
  id        String   @id @default(cuid())
  weekStart DateTime @unique @db.Date
  targetKm  Int
}

// One row per logged run (ADD-1..8). Pace is durationSeconds / distanceKm,
// derived everywhere and stored nowhere (ADD-4). Start time, elevation and
// route type are deliberately absent until the designer answers how they are
// captured (DET-7, assumption A10).
model Run {
  id              String   @id @default(cuid())
  routeName       String
  distanceKm      Float
  durationSeconds Int
  date            DateTime @db.Date
  effort          String // Easy | Medium | Hard
  note            String   @default("")

  @@index([date])
}

// One row per registered account (RUN-56), the anchor entity of the v2
// community phase. Deliberately standalone: the single-row Profile above
// stays untouched until the phase B per-user-scoping tasks decide how v1
// data attaches to accounts. passwordHash is a bcrypt hash and must never
// leave the auth service in any response or log line (RUN-56 AC4). The
// privacy toggles (profilePublic, showOnLeaderboard, showRoutes) arrive
// additively in RUN-64.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  createdAt    DateTime @default(now())
}

// One row per generation (AIC-3..9). The newest row for the current week is
// "This week's plan"; the newest row of each past week feeds "Previous plans".
// ranKm and the Hit/Missed outcome are derived from Run and WeekTarget.
model CoachPlan {
  id                 String   @id @default(cuid())
  weekStart          DateTime @db.Date
  suggestedTargetKm  Int
  deltaVsLastWeekPct Int
  sessions           String // "3-4"
  keyWorkout         String // "1 tempo"
  narrative          String
  updatedAt          DateTime @updatedAt

  @@index([weekStart])
}
