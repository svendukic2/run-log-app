// Run Log Tracker - database shape, live since RUN-46 (see docs/data-model.md,
// "Adopting the database"). Mirrors the TypeScript types in frontend/src/lib/
// and must stay in sync with them: string ids, calendar-day dates, durations
// in seconds, capitalized enums (real database enums since RUN-78), derived
// data (records, totals, pace) never stored.
//
// Since RUN-78 every table also carries updatedAt, and every migration in
// this directory has to be safe against a database that already holds rows
// (there has been one since RUN-60). That is why the hand-written SQL adds
// audit columns WITH a default and drops the default afterwards: the default
// backfills the rows that already exist, and dropping it again leaves the
// column exactly as Prisma renders it, so `migrate diff` stays quiet.

// Prisma 7: the client is generated TypeScript compiled with the rest of the
// app, and the connection URL lives in prisma.config.ts (CLI) and
// PrismaService (runtime), not here.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // The backend emits CommonJS: tsconfig is "module": "nodenext" and
  // package.json has no "type": "module", which under nodenext means CJS
  // output. The default ESM generator output (import.meta) does not survive
  // that, hence cjs here.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// The two vocabularies the UI copy is written in, as real database enums
// since RUN-78 (they were TEXT before). The values are capitalized exactly
// as the frontend unions spell them (EFFORT_LEVELS in
// frontend/src/lib/runMath.ts, RUNNING_LEVELS in the profile DTO), because
// the enum label IS the API value - there is no translation layer.
//
// What this buys: the database now refuses a value outside the vocabulary,
// which is what let the read-side guards go (toEffort, toRunningLevel and
// their 500s). What it costs: adding a level is a migration rather than an
// edit to one array, which for two closed three-value vocabularies is the
// right trade.
enum Effort {
  Easy
  Medium
  Hard
}

enum RunningLevel {
  Beginner
  Intermediate
  Advanced
}

// One row per user since RUN-57 (was single-row in v1, WEL-4). runningLevel
// is one of Beginner | Intermediate | Advanced (LVL-2); defaultWeeklyGoalKm
// seeds future weeks only (SET-3, SET-6).
// The setup answers only, since RUN-59: the runner's name and email live on
// the User row, which every social surface already reads, so keeping copies
// here only created two truths for one fact.
model Profile {
  id                  String       @id @default(cuid())
  runningLevel        RunningLevel
  defaultWeeklyGoalKm Int
  updatedAt           DateTime     @updatedAt
  userId              String       @unique
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// One row per user since RUN-57: the onboarding goal period (GOAL-2..4).
// km stays within 0-60 (A17); endDate null renders as "No end date".
model Goal {
  id        String    @id @default(cuid())
  km        Int
  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  updatedAt DateTime  @updatedAt
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// At most one row per user per week, keyed by the Monday of that week.
// Snapshotted from the goal's km the first time a week is used, then only
// changed by the coach's "Apply to weekly goal" for the current week
// (AIC-5, A15). Past rows never change, which is what makes Hit/Missed
// history possible (AIC-7).
model WeekTarget {
  id        String   @id @default(cuid())
  weekStart DateTime @db.Date
  targetKm  Int
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStart])
}

// One row per logged run (ADD-1..8), owned by its runner since RUN-57. Pace
// is durationSeconds / distanceKm, derived everywhere and stored nowhere
// (ADD-4). Start time, elevation and route type are deliberately absent
// until the designer answers how they are captured (DET-7, assumption A10).
model Run {
  id              String   @id @default(cuid())
  routeName       String
  // NUMERIC(5, 2) since RUN-78, not DOUBLE PRECISION: a distance is money,
  // not physics. 12.3 has no exact binary representation, so summing floats
  // produced totals like 30.000000000000004 that the leaderboard had to
  // round back into honesty. Precision 5 is provably enough because RUN-72
  // caps a single run at 150 km, and scale 2 matches what the form accepts;
  // Postgres rounds a third decimal away on write, which is the "stored
  // exactly at two decimals" the ticket asks for.
  //
  // The cost is that Prisma types this field as Decimal (a decimal.js
  // object), and a Decimal reaching the browser as {s, e, d} would be a
  // broken API. It is converted at the backend boundary and nowhere else -
  // see common/decimal.ts, which lists every place that conversion happens.
  distanceKm      Decimal  @db.Decimal(5, 2)
  durationSeconds Int
  date            DateTime @db.Date
  effort          Effort
  note            String   @default("")

  // When the row was written, so two runs on the same calendar day have a
  // real order instead of the arbitrary-but-deterministic cuid tiebreak
  // (RUN-78). `date` is still the sort key that matters - this only breaks
  // its ties - and it is part of the API contract, not just the database:
  // the client re-sorts its cache after every mutation, so the two
  // orderings have to be the same one. See runsNewestFirstOrder in
  // src/runs/run-response.ts and compareRunsNewestFirst in
  // frontend/src/lib/runs.ts.
  //
  // Rows that predate the migration all share its timestamp and therefore
  // still tie, falling through to the id exactly as before. Nothing can be
  // done about that: their real insertion order was never recorded.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The optional route (RUN-54), the columns RUN-53 deliberately left to
  // this ticket. All three are written together or not at all - a database
  // CHECK enforces that, see the migration - because two of them without
  // the third is not a partial route, it is an unreadable one:
  //   routePolyline  the provider's encoded polyline, precision 5
  //   routeWaypoints the points the runner tapped, [{lat, lng}, ...], 2-5 of
  //                  them: index 0 is Start, the last is Finish, the rest
  //                  are the numbered waypoints. Kept (rather than derived
  //                  from the polyline, which has hundreds of points) so
  //                  Edit can restore the picker and re-plan (AC5)
  //   routeSource    WHICH provider drew it. That is also what marks the
  //                  line as a reconstruction rather than GPS truth, so
  //                  RUN-55 knows to draw it dashed
  // A run with no route leaves all three NULL and behaves exactly as it did
  // before this ticket (AC3), which is why nothing here has a default.
  routePolyline  String?
  routeWaypoints Json?
  routeSource    String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The list query's full shape: filter by owner, ORDER BY (date, createdAt,
  // id) newest first - the same reasoning as the Follow and Notification
  // list indexes below. It was (userId, date) until RUN-78 added the
  // createdAt tiebreak; leaving it that way would have made every page of
  // the run list sort its date groups in memory.
  @@index([userId, date, createdAt, id])
}

// One row per registered account (RUN-56), the anchor entity of the v2
// community phase. Deliberately standalone: the single-row Profile above
// stays untouched until the phase B per-user-scoping tasks decide how v1
// data attaches to accounts. passwordHash is a bcrypt hash and must never
// leave the auth service in any response or log line (RUN-56 AC4).
//
// The three privacy toggles (RUN-64) live here, on the account, not on
// Profile: they gate what OTHER accounts may see, so they belong to the
// identity every community entity already hangs off. showOnLeaderboard
// landed first, pulled forward by RUN-69 because its event leaderboard has
// to respect it to exist at all (AC3); RUN-64 added profilePublic and
// showRoutes additively next to it and shipped the Settings card that
// flips all three. All three carry the roadmap's decided default - false,
// private, opt-in - so an existing account is never opted into anything by
// a migration. The reader of profilePublic and showRoutes is RUN-63's
// public profile page; showOnLeaderboard is read by the event leaderboard
// today (see common/privacy.ts for the gating helpers).
model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  passwordHash        String
  firstName           String
  lastName            String
  profilePublic       Boolean            @default(false)
  showOnLeaderboard   Boolean            @default(false)
  showRoutes          Boolean            @default(false)
  // Bumped by POST /api/auth/logout to end every session this account has
  // (RUN-74). Read only by the refresh endpoint, never by the request
  // guard. The default of 0 is load-bearing: a pre-RUN-74 token carries no
  // version claim, that absence reads as 0, and 0 is what this migration
  // gives every row that already existed - which is what stops the deploy
  // from signing out real users. See src/auth/token-lifecycle.ts.
  tokenVersion        Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  profile             Profile?
  goal                Goal?
  weekTargets         WeekTarget[]
  runs                Run[]
  coachPlans          CoachPlan[]
  following           Follow[]           @relation("UserFollowing")
  followers           Follow[]           @relation("UserFollowers")
  notifications       Notification[]
  eventsOwned         Event[]
  eventParticipations EventParticipant[]
}

// One row per follow edge (RUN-61): follower -> followee, one-directional
// ("friends" in the roadmap sense = two rows, one each way). The pair is
// unique so following twice is impossible at the schema level, which is what
// lets the API treat a repeat POST as an idempotent no-op. Both sides
// cascade: deleting an account removes every edge it participates in,
// whichever end it was on (AC4).
model Follow {
  id         String   @id @default(cuid())
  followerId String
  followeeId String
  createdAt  DateTime @default(now())
  // An edge is created and deleted, never edited, so this column will
  // normally equal createdAt forever. It is here because RUN-78 AC5 asks
  // for it on every table, and a uniform audit convention is worth more
  // than eight bytes saved on the one table that does not change.
  updatedAt  DateTime @updatedAt
  follower   User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  followee   User     @relation("UserFollowers", fields: [followeeId], references: [id], onDelete: Cascade)

  // The unique pair enforces one edge per direction (what makes the follow
  // endpoint idempotent). Each side also gets a composite index matching
  // the list queries' full shape - filter on one side, ORDER BY (createdAt,
  // id) - so paging never has to fetch and sort a user's entire edge set.
  @@unique([followerId, followeeId])
  @@index([followerId, createdAt, id])
  @@index([followeeId, createdAt, id])
}

// One row per delivered notification (RUN-65), owned by the user whose bell
// it lands in. type is one of new-follower | followed-ran | event-joined
// (NOTIFICATION_TYPES in notifications.service.ts; event-joined is defined
// now and starts being written when events land in C2). payload is a
// self-contained snapshot of everything rendering needs - actor name, run
// stats - copied at write time, so a later unfollow or run delete can never
// break the list (AC4). readAt null = unread; set once by mark-read.
model Notification {
  id        String    @id @default(cuid())
  type      String // new-follower | followed-ran | event-joined
  payload   Json
  readAt    DateTime?
  createdAt DateTime  @default(now())
  // Moves when the row is marked read, which is the only edit a
  // notification ever gets.
  updatedAt DateTime  @updatedAt
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The list query's full shape: filter by owner, ORDER BY (createdAt, id)
  // newest first - same reasoning as the Follow list indexes. The unread
  // count filters on (userId, readAt), covered by its own index.
  @@index([userId, createdAt, id])
  @@index([userId, readAt])
}

// One row per community event (RUN-67). Any user creates one and becomes its
// owner; both dates are inclusive calendar days and upcoming/active/finished
// is derived from them against today at read time, never stored (a stored
// state would go stale at every midnight). targetKm is an optional collective
// distance goal and stays a Float: it is one round number a human types once,
// never summed and never compared for equality, so the exactness RUN-78 gave
// Run.distanceKm would buy nothing here. The owner cascade deletes the event (and, through
// it, the participant rows): an event does not outlive its owner.
//
// Not visible here: the add_event_date_order_check migration adds
// CHECK ("endDate" >= "startDate") at the database level, because Prisma
// cannot express CHECK constraints. It backstops the service-side
// validation against concurrent PATCHes racing the merged-pair check.
model Event {
  id           String             @id @default(cuid())
  name         String
  description  String             @default("")
  startDate    DateTime           @db.Date
  endDate      DateTime           @db.Date
  targetKm     Float?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  ownerId      String
  owner        User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  participants EventParticipant[]

  // The list orders chronologically (startDate, id) and the state filter is
  // a date-range comparison on either column, so each date gets an index;
  // startDate's carries the id tiebreak to cover the full ORDER BY shape.
  @@index([startDate, id])
  @@index([endDate])
  @@index([ownerId])
}

// One row per joined user per event (RUN-67), including the owner, who joins
// at creation (AC1). The unique pair makes a repeat join impossible at the
// schema level, which is what lets the API treat it as an idempotent no-op -
// the same construction as Follow. Both FKs cascade: deleting the event or
// the participant's account removes the row (AC5).
model EventParticipant {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  // Like Follow's: a join row is created and deleted, never edited. Present
  // for the uniform audit convention (RUN-78 AC5).
  updatedAt DateTime @updatedAt
  eventId   String
  userId    String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  // The reverse lookup: which events this user joined (the "joined" flag on
  // the list resolves per page through the unique pair; this serves the
  // per-user view RUN-68 needs).
  @@index([userId])
}

// One row per generation (AIC-3..9). The newest row for the current week is
// "This week's plan"; the newest row of each past week feeds "Previous plans".
// ranKm and the Hit/Missed outcome are derived from Run and WeekTarget.
// The plan is COMPUTED ON THE CLIENT (frontend/src/lib/plan.ts) and this
// table has no reader and no writer in backend/src - it is the agreed shape
// for RUN-32/RUN-35, nothing more. RUN-78 replaced the display string
// "3-4" with the two numbers the frontend plan already carries
// (sessionsMin, sessionsMax), so the schema describes the data instead of
// its rendering: "3-4" cannot be compared, averaged or bounded without
// being parsed back, and a string is where "3 to 4" and "3-4" and "3 - 4"
// all become equally valid. Formatting the range is the UI's job.
model CoachPlan {
  id                 String   @id @default(cuid())
  weekStart          DateTime @db.Date
  suggestedTargetKm  Int
  deltaVsLastWeekPct Int
  sessionsMin        Int
  sessionsMax        Int
  keyWorkout         String // "1 tempo"
  narrative          String
  updatedAt          DateTime @updatedAt
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, weekStart])
}
